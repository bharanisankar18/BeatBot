# Copy this file to ".env" and fill in the values.

# From https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather -> /newbot
BOT_TOKEN=123456789:AAExampleExampleExampleExample

# Run "python generate_session.py" to get this (assistant user account)
SESSION_STRING=

# Optional: your Telegram user ID(s), comma separated - can control the bot anywhere
SUDO_USERS=

# Optional: only admins can pause/skip/stop (true/false)
ADMIN_ONLY=true

# Optional: longest track allowed, in minutes
MAX_DURATION_MIN=180
